pipeline {
  agent any
  environment { IMAGE = "your-account-id.dkr.ecr.your-region.amazonaws.com/fastapi-production-tutorial"; IMAGE_TAG = "${BUILD_NUMBER}" }
  stages {
    stage("Checkout") { steps { checkout scm } }
    stage("Install") { steps { sh "python3 -m pip install --upgrade pip && pip install -e . && pip install pytest pytest-asyncio ruff" } }
    stage("Lint") { steps { sh "ruff check ." } }
    stage("Test") { steps { sh "pytest -q" } }
    stage("Build") { steps { sh "docker build -t ${IMAGE}:${IMAGE_TAG} ." } }
    stage("Push") { when { branch "main" }; steps { sh "docker push ${IMAGE}:${IMAGE_TAG}" } }
    stage("Deploy") { when { branch "main" }; steps { sh "kubectl -n fastapi set image deployment/fastapi-api api=${IMAGE}:${IMAGE_TAG}"; sh "kubectl -n fastapi rollout status deployment/fastapi-api --timeout=180s" } }
  }
}
