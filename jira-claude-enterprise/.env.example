# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@postgres:5432/orchestrator
API_KEY=change-me-only-for-local-development
WORKSPACE_ROOT=/workspace/repository

# ---------------------------------------------------------------------------
# OIDC / RBAC
# ---------------------------------------------------------------------------
OIDC_ENABLED=true
OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=jira-claude-orchestrator
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
RBAC_REQUIRED=true

# ---------------------------------------------------------------------------
# Jira
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_REPOSITORY=company/repository
GITHUB_BASE_BRANCH=main

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_BACKEND=hybrid
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=repository-code
PGVECTOR_ENABLED=true
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_PROVIDER=stub
RERANKER_MODEL=

# ---------------------------------------------------------------------------
# Approval / execution
# ---------------------------------------------------------------------------
APPROVAL_TTL_SECONDS=1800
MAX_RETRIEVAL_RESULTS=12
TEST_TIMEOUT_SECONDS=300
